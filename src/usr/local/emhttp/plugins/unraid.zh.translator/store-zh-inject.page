<?php
/**
 * unraid.zh.translator — 全局注入点
 *
 * Unraid 的 webGui 会把所有 Menu='Buttons' 的 .page 渲染进顶栏，
 * 因此这段 PHP 在每一个 WebUI 页面上都会执行 —— 我们只在这里挂两个脚本：
 *   1) ajax/configjs.php  运行时配置（开关、范围、CSRF）
 *   2) js/store-zh.js     文本替换引擎（内部会判断当前页面是否需要工作）
 *
 * 不做任何 DOM 改写、不覆盖任何宿主插件文件，卸载即恢复原样。
 */
$uztBase = getenv('UZT_PLUGIN_DIR') ?: __DIR__;
// 与 CA 等官方插件一致：Unraid 渲染 .page 时 __DIR__ 不可靠，用 DOCUMENT_ROOT 定位
if (!is_file($uztBase . '/include/util.php')) {
    $uztDocroot = $_SERVER['DOCUMENT_ROOT'] ?? '';
    $uztDocroot = $uztDocroot !== '' ? rtrim($uztDocroot, '/') : '/usr/local/emhttp';
    if (is_file($uztDocroot . '/plugins/unraid.zh.translator/include/util.php')) {
        $uztBase = $uztDocroot . '/plugins/unraid.zh.translator';
    } else {
        $uztBase = '/usr/local/emhttp/plugins/unraid.zh.translator';
    }
}
if (!is_file($uztBase . '/include/util.php')) {
    $uztBase = '/usr/local/emhttp/plugins/unraid.zh.translator';
}
// 与 CA 等官方插件一致：Unraid 渲染 .page 时 __DIR__ 不可靠，用 DOCUMENT_ROOT 定位
if (!is_file($uztBase . '/include/util.php')) {
    $uztDocroot = $_SERVER['DOCUMENT_ROOT'] ?? '';
    $uztDocroot = $uztDocroot !== '' ? rtrim($uztDocroot, '/') : '/usr/local/emhttp';
    if (is_file($uztDocroot . '/plugins/unraid.zh.translator/include/util.php')) {
        $uztBase = $uztDocroot . '/plugins/unraid.zh.translator';
    } else {
        $uztBase = '/usr/local/emhttp/plugins/unraid.zh.translator';
    }
}
if (!is_file($uztBase . '/include/util.php')) {
    return;   // 文件不完整：静默跳过，不影响宿主页面
}
require_once $uztBase . '/include/util.php';

if (!\UZT\Config::bool('ENABLED')) {
    return;
}
$base = '/plugins/unraid.zh.translator';
$stamp = (string)@filemtime($uztBase . '/js/store-zh.js');
if ($stamp === '') {
    $stamp = \UZT\VERSION;
}
?>
<script src="<?= $base ?>/ajax/configjs.php?v=<?= $stamp ?>"></script>
<script src="<?= $base ?>/js/uzt-norm.js?v=<?= $stamp ?>"></script>
<script src="<?= $base ?>/js/store-zh.js?v=<?= $stamp ?>" defer></script>
