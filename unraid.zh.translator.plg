<script>
(function () {
  var CSRF = <?= json_encode($csrf, JSON_HEX_TAG | JSON_HEX_AMP) ?>;
  var API = '/plugins/unraid.zh.translator/ajax';
  var FIELDS = ['ENABLED','SCOPE','AUTO_NEW','SYNC_ON_LOOKUP','SYNC_MAX_CHARS','HOURLY_CHAR_BUDGET','PHP_CLI','FEED_SOURCE','FEED_URL',
    'API_BASE','MODEL','JSON_MODE','TEMPERATURE','BATCH_ITEMS','BATCH_CHARS','TIMEOUT','RETRIES',
    'CRON','WORKER_SECONDS'];

  function $(id) { return document.getElementById(id); }
  function post(action, extra) {
    var body = Object.assign({ action: action, csrf: CSRF }, extra || {});
    return fetch(API + '/settings.php', {
      method: 'POST', credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
      body: JSON.stringify(body)
    }).then(function (r) { return r.json(); });
  }
  function get(action, extra) {
    var q = new URLSearchParams(Object.assign({ csrf: CSRF }, extra || {}));
    return fetch(API + '/' + action + '.php?' + q.toString(), { credentials: 'same-origin' })
      .then(function (r) { return r.json(); });
  }
  function hint(el, text, cls) {
    if (typeof el === 'string') { el = $(el); }
    if (!el) { return; }
    el.textContent = text || '';
    el.className = 'muted' + (cls ? ' ' + cls : '');
  }
  function collect() {
    var cfg = {};
    FIELDS.forEach(function (f) { if ($(f)) { cfg[f] = $(f).value; } });
    var keyInput = $('API_KEY');
    if (keyInput && keyInput.value.trim() !== '') { cfg.API_KEY = keyInput.value.trim(); }
    return cfg;
  }
  function save(silent) {
    var payload = { config: collect() };
    if ($('API_KEY_CLEAR') && $('API_KEY_CLEAR').checked) { payload.clear_key = true; }
    return post('save', payload).then(function (res) {
      if (!res.ok) { hint('save-hint', '保存失败：' + (res.error || ''), 'warn'); return res; }
      if (!res.ok && res.error) {
        hint('save-hint', '保存失败：' + res.error, 'warn');
        return res;
      }
      var msg = '已保存';
      if (res.errors && res.errors.length) { msg += '（提示：' + res.errors.join('；') + '）'; }
      if (res.cron_changed) { msg += ' · Cron 已重载'; }
      if (!silent) { hint('save-hint', msg, 'ok'); setTimeout(function(){ hint('save-hint',''); }, 4000); }
      if ($('API_KEY')) { $('API_KEY').value = ''; }
      if ($('API_KEY_CLEAR')) { $('API_KEY_CLEAR').checked = false; }
      return res;
    });
  }

  // 标签页
  document.querySelectorAll('.uzt .tabs button').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.querySelectorAll('.uzt .tabs button').forEach(function (b) { b.classList.remove('on'); });
      document.querySelectorAll('.uzt .panel').forEach(function (p) { p.classList.remove('on'); });
      btn.classList.add('on');
      var p = document.querySelector('.uzt .panel[data-panel="' + btn.dataset.tab + '"]');
      if (p) { p.classList.add('on'); }
      if (btn.dataset.tab === 'log') { refresh(); }
    });
  });

  // 按钮
  document.querySelectorAll('.uzt button.act').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var act = btn.dataset.act;
      if (act === 'save') { save(false); return; }
      if (act === 'test') {
        hint('test-hint', '测试中…');
        $('test-out').textContent = '';
        save(true).then(function () {
          return post('test');
        }).then(function (res) {
          var r = res.result || res;
          if (r.ok) {
            hint('test-hint', '连接正常（' + r.ms + ' ms）', 'ok');
            $('test-out').textContent = '模型 ' + r.model + '\n原文：' + r.sample_src + '\n译文：' + r.sample_dst;
          } else {
            hint('test-hint', '失败：' + (r.error || res.error || '未知错误'), 'warn');
          }
        }).catch(function (e) { hint('test-hint', '请求异常：' + e, 'warn'); });
        return;
      }
      if (act === 'refresh') { refresh(); return; }
      if (act === 'wipe' && !confirm('将清空全部已保存译文（不影响设置），确定吗？')) { return; }
      if (act === 'drop-pending' && !confirm('将删除所有「未翻译」的条目，之后只在你浏览页面时按需翻译（已译的保留）。确定吗？')) { return; }
      if (act === 'defaults' && !confirm('恢复默认设置（含清空 API Key）？译文缓存不会动。')) { return; }
      btn.disabled = true;
      var extra = btn.dataset.force ? { force: 1 } : {};
      hint('task-hint', '执行中…');
      post(act, extra).then(function (res) {
        btn.disabled = false;
        if (act === 'save') { return; }
        if (!res.ok) { hint('task-hint', '失败：' + (res.error || ''), 'warn'); return; }
        if (act === 'sync' || act === 'translate') {
          hint('task-hint', '已启动后台任务，进度见下方日志', 'ok');
        } else if (act === 'drop-pending') {
          hint('task-hint', '已清空未译队列（删除 ' + (res.removed || 0) + ' 条），之后按需翻译', 'ok');
        } else if (act === 'compact') {
          hint('task-hint', '已删除 ' + (res.removed || 0) + ' 条短文本/本机插件片段（阈值 ' + (res.min_chars || 0) + ' 字符）', 'ok');
        } else if (act === 'retry-failed') {
          hint('task-hint', '已把 ' + (res.reset || 0) + ' 条失败片段放回队列', 'ok');
        } else if (act === 'prune') {
          hint('task-hint', '已清理 ' + (res.result ? res.result.removed : 0) + ' 条过期词条', 'ok');
        } else if (act === 'wipe') {
          hint('task-hint', '译文已清空', 'ok');
        } else if (act === 'defaults') {
          hint('task-hint', '已恢复默认，请刷新页面', 'ok');
        }
        refresh();
      }).catch(function (e) {
        btn.disabled = false;
        hint('task-hint', '请求异常：' + e, 'warn');
      });
    });
  });

  // 状态轮询
  function fmt(n) { return (n === null || n === undefined) ? '—' : Number(n).toLocaleString(); }
  function humanDur(sec) {
    if (!sec || sec < 0) { return '—'; }
    if (sec < 90) { return sec + ' 秒'; }
    if (sec < 5400) { return Math.round(sec / 60) + ' 分钟'; }
    return (sec / 3600).toFixed(1) + ' 小时';
  }
  function kindName(k) {
    var map = { overview: '应用简介', requires: '运行要求', cat: '分类名称', field: '模板字段说明',
      fieldname: '模板字段名', branch: '分支说明', note: '应用备注',
      localdesc: '本地插件描述', localchg: '本地插件更新日志', live: '页面即时采集', '': '未分类' };
    return map[k] || k;
  }
  var lastRev = null;
  function refresh() {
    if (document.hidden) { return Promise.resolve(); }
    var light = (lastRev !== null);
    return get('status', light ? { light: 1 } : {}).then(function (res) {
      if (!res.ok) { return; }
      if (light && res.revision !== undefined && String(res.revision) === String(lastRev)) {
        $('worker-state').textContent = '后台任务状态：' + (res.worker_running ? '运行中…' : '空闲');
        return;
      }
      lastRev = (res.stats && res.stats.revision) || res.revision || null;
      var s = res.stats || {};
      $('s-done').textContent = fmt(s.done);
      $('s-pending').textContent = fmt(s.pending);
      $('s-total').textContent = fmt(s.total);
      $('s-failed').textContent = fmt(s.failed);
      $('s-chars').textContent = fmt(s.src_chars);
      var pct = s.total > 0 ? Math.round(s.done * 1000 / s.total) / 10 : 0;
      $('s-bar').style.width = pct + '%';
      $('s-backend').textContent = s.backend || '—';
      if (res.meta) {
        $('s-synced').textContent = res.meta.synced_at ? new Date(res.meta.synced_at * 1000).toLocaleString() : '从未';
        $('s-feedupd').textContent = res.meta.feed_updated || '—';
        $('s-feedapps').textContent = res.meta.feed_apps || '—';
        $('s-plugins').textContent = res.meta.plugins || '—';
      }
      // 词库占用（字节）
      var by = document.getElementById('s-bytes');
      if (by && typeof s.db_bytes === 'number') {
        var u = ['B','KB','MB','GB'], n = s.db_bytes, i = 0;
        while (n >= 1024 && i < 3) { n = Math.round(n / 1024); i++; }
        by.textContent = n + u[i];
      }
      if (res.failures && res.failures.length) {
        var fl = document.getElementById('fail-line');
        if (fl) {
          fl.style.display = '';
          fl.textContent = '最近失败原因：' + res.failures.map(function (f) {
            return (f.err || '未知').slice(0, 60) + ' ×' + f.n;
          }).join(' · ') + '（修好后点「重试失败片段」）';
        }
      }
      if (res.env) {
        var e2 = res.env;
        var bits2 = [];
        bits2.push('PHP CLI ' + (e2.php_cli || '未找到'));
        bits2.push('日志目录' + (e2.log_writable ? '可写' : '不可写'));
        bits2.push('/boot' + (e2.boot_writable ? '可写' : '不可写'));
        if (e2.ca_local && e2.ca_local.file) {
          bits2.push('CA 本地源 ' + humanDur(e2.ca_local.age) + '前');
        } else {
          bits2.push('未发现 CA 本地源');
        }
        if (e2.feed_source) {
          var srcName = { 'ca-local': 'CA 本地缓存', 'cdn': '官方 CDN', 'github': 'GitHub 备份', 'own-cache': '本地下载缓存', 'custom': '自定义源' };
          bits2.push('上次同步用 ' + (srcName[e2.feed_source] || e2.feed_source));
        }
        var el2 = document.getElementById('env-line');
        if (el2) {
          el2.textContent = '环境自检：' + bits2.join(' · ');
          if (!e2.log_writable || !e2.boot_writable || !e2.php_cli) {
            el2.style.color = '#e0a028';
          }
        }
      }
      if (res.estimate) {
        var e = res.estimate;
        var bits = ['待译 ' + fmt(e.pending) + ' 条', '约 ' + fmt(e.pending_chars) + ' 字符',
          '约 ' + fmt(e.requests) + ' 次请求'];
        if (e.avg_req_ms > 0) {
          bits.push('按上轮实测 ' + e.avg_req_ms + ' ms/次，预计 ' + humanDur(e.eta_seconds));
        }
        var line = document.getElementById('est-line');
        if (line) { line.textContent = '队列估算：' + bits.join(' · '); }
      }
      $('worker-state').textContent = '后台任务状态：' + (res.worker_running ? '运行中…' : '空闲')
        + ' · 待译 ' + fmt(s.pending) + ' 条';
      var tb = $('kinds-body');
      if (tb && res.kinds) {
        tb.innerHTML = res.kinds.map(function (k) {
          var p = k.total > 0 ? Math.round(k.done * 1000 / k.total) / 10 : 0;
          return '<tr><td>' + kindName(k.kind) + '</td><td>' + fmt(k.total) + '</td><td>' + fmt(k.done)
            + '</td><td>' + p + '%</td></tr>';
        }).join('') || '<tr><td colspan="4" class="muted">暂无数据，先点「同步应用源」</td></tr>';
      }
      if ($('auto-refresh') && $('auto-refresh').checked) {
        var box = $('log-box');
        var atBottom = box.scrollTop + box.clientHeight >= box.scrollHeight - 20;
        box.textContent = res.log || '（暂无日志）';
        if (atBottom) { box.scrollTop = box.scrollHeight; }
      }
    }).catch(function () { /* 静默 */ });
  }

  refresh();
  setInterval(refresh, 3000);
})();
</script>
]]></INLINE></FILE>

<FILE Run="/bin/bash">
<INLINE>
# 权限与运行目录
chmod -R a+r /usr/local/emhttp/plugins/unraid.zh.translator
find /usr/local/emhttp/plugins/unraid.zh.translator -type d -exec chmod 0775 {} \;
chmod 0755 /usr/local/emhttp/plugins/unraid.zh.translator/scripts/worker.php 2>/dev/null
mkdir -p /usr/local/emhttp/plugins/unraid.zh.translator/var
chmod 0775 /usr/local/emhttp/plugins/unraid.zh.translator/var
# 默认配置（不存在才写，避免覆盖用户设置）
CFG=/boot/config/plugins/unraid.zh.translator/translator.cfg
if [ ! -f "$CFG" ]; then
  /usr/bin/php -r 'require "/usr/local/emhttp/plugins/unraid.zh.translator/include/util.php"; require "/usr/local/emhttp/plugins/unraid.zh.translator/include/config.php"; UZT\Config::write(UZT\Config::DEFAULTS);' 2>/dev/null || true
fi
# 首次安装提示
echo
echo "----------------------------------------------------------"
echo " 插件中文化已安装。"
echo " 1. 打开 设置 → 插件中文化，填写大模型 API（或本地 Ollama）"
echo " 2. 点「测试连接」→「同步应用源」→「翻译待译队列」"
echo " 3. 打开 应用(Apps) / 插件(Plugins) 页面即可看到中文"
echo "----------------------------------------------------------"
echo
</INLINE>
</FILE>
</PLUGIN>
